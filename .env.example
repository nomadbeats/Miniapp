# Telegram Music Bot Configuration

# Telegram Bot Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: Telegram Chat ID for sending messages
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional: Music Source Directory
MUSIC_SOURCE_DIR=path_to_your_music_source

# Optional: Logging Level
LOG_LEVEL=info

