{
  "name": "telegram-games-backend",
  "version": "1.0.0",
  "description": "Express.js backend for Telegram Mini App gaming platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "node --require=dotenv/config ./node_modules/.bin/knex migrate:latest",
    "db:rollback": "node --require=dotenv/config ./node_modules/.bin/knex migrate:rollback",
    "db:seed": "node --require=dotenv/config ./node_modules/.bin/knex seed:run",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "knex": "^3.1.0",
    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.1.2",
    "crypto-js": "^4.2.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "joi": "^17.11.0",
    "redis": "^4.6.13",
    "axios": "^1.6.5"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.10.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "tsx": "^4.7.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0"
  }
}
